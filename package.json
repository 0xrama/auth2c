{
  "name": "auth2c",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply auth2c-production --remote",
    "db:migrate:local": "wrangler d1 migrations apply auth2c-production --local",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "wrangler": "4.110.0"
  },
  "allowScripts": {
    "@cloudflare/vitest-pool-workers@0.18.6": true,
    "workerd@1.20260714.1": true,
    "workerd@1.20260708.1": true,
    "esbuild@0.28.1": true
  }
}
